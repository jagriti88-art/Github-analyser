# ---- Required ----
# Groq API key for the AI review layer. Get one free at https://console.groq.com/keys
# If omitted the app still works: it returns the deterministic score without AI commentary.
GROQ_API_KEY=

# ---- Strongly recommended ----
# GitHub personal access token (classic or fine-grained, no scopes needed for public repos).
# Without it the GitHub API allows only 60 requests/hour; with it, 5000/hour.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ---- Optional ----
PORT=5000
# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173
# Groq model used for the qualitative review.
GROQ_MODEL=openai/gpt-oss-120b
# How long an analysis is cached, in seconds.
CACHE_TTL_SECONDS=600
